# ── Backend ──────────────────────────────────────────────
APP_TITLE="recHERsion 2026 — Project API"
PORT=8000
DB_PATH=app.db
# Comma-separated. Use "*" for the hackathon; lock it down in production.
ALLOWED_ORIGINS=*
MAX_UPLOAD_MB=10

# ── External API (optional) ──────────────────────────────
EXTERNAL_API_URL=https://httpbin.org/post
EXTERNAL_API_KEY=
EXTERNAL_TIMEOUT=8
EXTERNAL_RETRIES=2

# ── Frontend ─────────────────────────────────────────────
# Leave as /api in dev (Vite proxies it). Point at your hosted backend for deploy.
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:8000
